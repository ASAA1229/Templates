# staging profile (US-H01). Placeholders only: copy to the host's secret store or
# a git-ignored apps/api/.env and replace values there. Never commit real values.
NODE_ENV=staging
PORT=4000
WEB_ORIGIN=https://staging.example.invalid
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/templates_staging?schema=public"
SESSION_ABSOLUTE_MINUTES=480
SESSION_IDLE_MINUTES=30
# Must be true wherever the app is reached over HTTPS; the API refuses to start otherwise in staging/production.
COOKIE_SECURE=true
WEB_DIST_DIR=../web/dist
LOG_LEVEL=info
# Project generation: template library (read-only) and output root outside the platform source.
TEMPLATE_LIBRARY_DIR=
GENERATION_OUTPUT_DIR=
# Engineering workspace: Git executable (name on PATH or absolute path) and per-command timeout in ms.
GIT_EXECUTABLE=git
GIT_TIMEOUT_MS=20000
