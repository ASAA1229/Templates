# Copy is created automatically by `npm run db:local -- init`. Placeholders only — never commit real values.
NODE_ENV=development
PORT=4000
# Public origin of the web app; mutating requests from any other Origin are rejected.
WEB_ORIGIN=http://localhost:5000
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:54329/templates_dev?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:54329/templates_test?schema=public"
# Session policy (minutes)
SESSION_ABSOLUTE_MINUTES=720
SESSION_IDLE_MINUTES=30
# Set true only behind HTTPS (production/staging).
COOKIE_SECURE=false
# Optional: serve the built web app from the API (single-process local deployment).
WEB_DIST_DIR=
LOG_LEVEL=info
# Project generation (US-E01/E02). Defaults: apps/api/template-library and <repo>/.local/generated.
TEMPLATE_LIBRARY_DIR=
GENERATION_OUTPUT_DIR=
# Engineering workspace: Git executable (name on PATH or absolute path) and per-command timeout in ms.
GIT_EXECUTABLE=git
GIT_TIMEOUT_MS=20000
# Optional AI suggestions (off by default); JARVIS keys are server-side only.
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
JARVIS_AI_URL=http://127.0.0.1:3100
JARVIS_AI_KEY=
AI_TIMEOUT_MS=60000

# Optional JARVIS mini-features (summaries, classification, review assist). Off by default; needs JARVIS_AI_KEY.
JARVIS_FEATURES_ENABLED=false

# Local delivery sink for repository handoff copies and deployment bundles (nothing is sent externally).
# DELIVERY_DIR=

# Optional connector endpoints. Unset means only the local mock connectors exist. Credentials come from
# the JENKINS_TOKEN / NEXUS_TOKEN environment variables at call time and are never stored.
# CONNECTOR_JENKINS_URL=
# CONNECTOR_JENKINS_JOBS=
# CONNECTOR_NEXUS_URL=
# CONNECTOR_NEXUS_REPOSITORIES=

# ASAA ecosystem event producer (asaa.event.v1). Disabled unless URL, org id and credentials are all set.
# HTTPS is required unless the URL is loopback. Secrets live in the environment only; never commit real values.
ASAA_EVENTS_URL=
ASAA_ORG_ID=
ASAA_EVENTS_TOKEN_URL=
ASAA_EVENTS_CLIENT_ID=templates-events
ASAA_EVENTS_CLIENT_SECRET=
# Static bearer token fallback when client credentials are not used.
ASAA_EVENTS_TOKEN=

# Optional single sign-on via the shared ASAA identity provider (OIDC code flow + PKCE). Off unless all three are set.
# SSO only signs in EXISTING local accounts linked by verified email or an explicit subject link; roles stay in Templates.
# The issuer must be https (loopback http allowed). The redirect URI is WEB_ORIGIN + /api/auth/sso/callback
# (the realm registers http://127.0.0.1:5000/* and http://127.0.0.1:8200/*, so set WEB_ORIGIN accordingly).
# TEMPLATES_OIDC_CLIENT_ID documented value: templates-web
TEMPLATES_OIDC_ISSUER=
TEMPLATES_OIDC_CLIENT_ID=
TEMPLATES_OIDC_CLIENT_SECRET=
