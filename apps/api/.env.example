# Copy is created automatically by `npm run db:local -- init`. Placeholders only — never commit real values.
NODE_ENV=development
PORT=4000
# Public origin of the web app; mutating requests from any other Origin are rejected.
WEB_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:54329/templates_dev?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:54329/templates_test?schema=public"
# Session policy (minutes)
SESSION_ABSOLUTE_MINUTES=720
SESSION_IDLE_MINUTES=30
# Set true only behind HTTPS (production/staging).
COOKIE_SECURE=false
# Optional: serve the built web app from the API (single-process local deployment).
WEB_DIST_DIR=
LOG_LEVEL=info
# Project generation (US-E01/E02). Defaults: apps/api/template-library and <repo>/.local/generated.
TEMPLATE_LIBRARY_DIR=
GENERATION_OUTPUT_DIR=
# Engineering workspace: Git executable (name on PATH or absolute path) and per-command timeout in ms.
GIT_EXECUTABLE=git
GIT_TIMEOUT_MS=20000
